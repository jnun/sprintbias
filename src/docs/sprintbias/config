# SprintBias Configuration
# Edit freely. Changes preserved across updates. Format: KEY=VALUE
#
# Local overlay: create docs/sprintbias/config.local (same KEY=VALUE format) for
# semi-permanent personal pins — CLI, PROVIDER, MODE, MODEL_* — that win over
# this file, are gitignored, and never ship. A key set there overrides the value
# here; setting it empty (KEY=) clears this file's value locally. Use it to pin,
# say, MODEL_DEFAULT=claude-opus-4-8 for yourself without changing the default
# everyone else gets. Precedence: env var → --model flag → config.local → config.

# AI CLI binary for exec mode. Verified first-class profiles: claude, grok.
# Any other name falls back to a generic prompt passthrough. Inside an AI
# session, MODE=emit is used and this is ignored. See MODE below.
# Per-run override (does not rewrite this file): ./sprint.sh -c | -g <command>
# or env SPRINTBIAS_CLI / SPRINTBIAS_PROVIDER (legacy SPRINTMD_CLI /
# SPRINTMD_PROVIDER still honored).
CLI=grok

# Capability tier for this install:
#   claude-code | grok-build | cursor | openai | generic
# Set by setup.sh from your provider choice. Scripts read it (via
# sprintbias_ai_tier) to use full orchestration on claude-code and grok-build,
# and degrade gracefully elsewhere. Empty = inferred from CLI above. See
# docs/sprintbias/ai/provider-capabilities.md.
# Per-run: ./sprint.sh -c (claude-code) or ./sprint.sh -g (grok-build).
PROVIDER=grok-build

# How AI commands deliver their prompt:
#   emit  — print the prompt for the agent you're already in (Claude Code,
#           Grok Build, Cursor, etc.) to run — no nested CLI
#   exec  — spawn the CLI binary above (for a plain terminal, loops, CI)
#   (empty) — auto: emit inside an agent session (CLAUDECODE, GROK_AGENT, …),
#             otherwise exec
MODE=

# Default model. Empty = let the CLI pick its own default (or a strong tier
# default on claude-code / grok-build via sprintbias_tier_model).
# Use a model id your CLI understands (grok models / claude docs). Claude-only
# names (opus, sonnet, haiku) on grok-build are auto-remapped to grok-4.5.
MODEL_DEFAULT=grok-4.5

# Per-script models. Empty = fall back to MODEL_DEFAULT.
# Interactive + spine flows (chat, gate, work, polish, …): when left empty on
# claude-code they default to opus; on grok-build to grok-4.5. Set a value here
# to pin a specific model instead.
MODEL_FEATURE=
MODEL_IDEA=
MODEL_CHAT=
MODEL_GATE=
MODEL_SPLIT=
MODEL_SPRINT=
MODEL_WORK=
MODEL_PROFILE=
MODEL_CODE_AUDIT=
MODEL_EXCELLENCE=
MODEL_POLISH=
# Acceptance judge for `promote --audit` (Success-criteria sign-off → done/).
MODEL_ACCEPT=
MODEL_AUDIT=
MODEL_DEPS=
# Cheap pass for chat-folder / chat-bugs verdict-first sort (not a user command).
MODEL_TRIAGE=
# Dual-persona critique for `plan think` (not a user-facing top-level command).
MODEL_PLAN_THINK=
MODEL_DRIFT=

# Budget caps per invocation (USD). Empty = no cap.
# Applied on tiers whose CLI supports a spending cap — today Claude Code only.
# On every other tier (Grok Build, Cursor, OpenAI, generic) these are ignored
# and the run is uncapped; nothing is sent to the provider.
BUDGET_WORK=10.00
BUDGET_AUDIT=5.00

# Code audit max iterative passes
AUDIT_MAX_PASSES=2
